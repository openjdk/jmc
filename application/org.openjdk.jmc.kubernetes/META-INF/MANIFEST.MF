Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %Bundle-Name
Bundle-SymbolicName: org.openjdk.jmc.kubernetes;singleton:=true
Bundle-Version: 10.0.0.qualifier
Automatic-Module-Name: org.openjdk.jmc.kubernetes
Bundle-RequiredExecutionEnvironment: JavaSE-17
Require-Bundle: org.openjdk.jmc.jolokia,
 org.eclipse.core.runtime,
 org.eclipse.ui,
 org.openjdk.jmc.ui,
 org.eclipse.swt,
 org.jolokia.client-kubernetes.standalone;bundle-version="2.6.1";visibility:=reexport,
 org.openjdk.jmc.rjmx
Export-Package: org.openjdk.jmc.kubernetes,
 org.openjdk.jmc.kubernetes.preferences
Import-Package: org.apache.commons.logging;version="1.2.0",
 org.jolokia.client;version="2.6.1",
 org.jolokia.client.exception;version="2.6.1",
 org.jolokia.client.jdkclient;version="2.6.1",
 org.jolokia.client.request;version="[2.6.1,3.0.0)",
 org.jolokia.client.response;version="2.6.1",
 org.jolokia.client.spi;version="[2.6.1,3.0.0)",
 org.jolokia.json;version="[2.6.1,3.0.0)",
 org.jolokia.json.parser;version="[2.6.1,3.0.0)"
Bundle-Activator: org.openjdk.jmc.kubernetes.JmcKubernetesPlugin
Bundle-ActivationPolicy: lazy
